{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/maps-routing",
            "train": {
                "size": 160000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 992,
                "dropout": 0.4630758885004009
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 4.712677213959946e-05,
            "weight_decay": 1.539659017656546,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00023224875101579792
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 40
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
