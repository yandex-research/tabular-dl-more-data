{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/maps-routing",
            "train": {
                "size": 40000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 784,
                "dropout": 0.33734694291452594
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 16,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 3.593409908891386e-05,
            "weight_decay": 1.0410240950017884,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0001148963694692896
            }
        },
        "batch_size": 512,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 2
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
