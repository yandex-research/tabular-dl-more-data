{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/maps-routing",
            "train": {
                "size": 320000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 848,
                "dropout": 0.46627390072290403
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0003544036685692825,
            "weight_decay": 1.0748847290699823,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00010337728524076049
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 42
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
