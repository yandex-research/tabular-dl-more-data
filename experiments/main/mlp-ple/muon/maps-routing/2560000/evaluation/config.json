{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/maps-routing",
            "train": {
                "size": 2560000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 6,
                "d_block": 688,
                "dropout": 0.05504513028932528
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 28,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00014859444057365616,
            "weight_decay": 0.46788712917678105,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00011095552808563351
            }
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 31
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
