{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/bank-fraud-datafusion",
            "train": {
                "size": "full",
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 6,
                "d_block": 896,
                "dropout": 0.2901842919926432
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 28,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0005365230923736129,
            "weight_decay": 0.009025447497228214,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00023978652401797796
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 11
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
