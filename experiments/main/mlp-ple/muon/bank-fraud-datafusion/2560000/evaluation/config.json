{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/bank-fraud-datafusion",
            "train": {
                "size": 2560000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 1008,
                "dropout": 0.3269398815635452
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 12,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 3.027076610934767e-05,
            "weight_decay": 0.030389837479599554,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.010877208701111106
            }
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 108
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
