{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/jane-street",
            "train": {
                "size": "full",
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 3,
                "d_block": 544,
                "dropout": 0.48644057771286336
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 8,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00021680458910921046,
            "weight_decay": 0.011562136043075034,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0006843057334108625
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 103
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
