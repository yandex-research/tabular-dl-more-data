{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/jane-street",
            "train": {
                "size": 1280000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 6,
                "d_block": 752,
                "dropout": 0.33944199371487066
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 24,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0008251776152957326,
            "weight_decay": 0.07147261708927018,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0007035632409218837
            }
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 39
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
