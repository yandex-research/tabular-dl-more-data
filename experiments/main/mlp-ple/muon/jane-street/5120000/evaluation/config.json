{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/jane-street",
            "train": {
                "size": 5120000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 224,
                "dropout": 0.32574699481100805
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 32,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0007550216643025517,
            "weight_decay": 0.034361615381070056,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0012138349423737771
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 106
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
