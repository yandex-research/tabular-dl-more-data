{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/jane-street",
            "train": {
                "size": 320000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 4,
                "d_block": 768,
                "dropout": 0.4721554394089283
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0005020562284865752,
            "weight_decay": 0.010392909722607485,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0011331891615523387
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 103
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
