{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/weather",
            "train": {
                "size": 320000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 992,
                "dropout": 0.36764928024552934
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.000330019958071418,
            "weight_decay": 0.11959800556771087,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0008438612070851016
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 4
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
