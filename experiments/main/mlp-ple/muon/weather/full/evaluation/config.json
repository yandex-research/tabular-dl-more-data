{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/weather",
            "train": {
                "size": "full",
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 848,
                "dropout": 0.4934261085964485
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 8.609050308408262e-05,
            "weight_decay": 0.4090991073990283,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00018975103424103112
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 40
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
