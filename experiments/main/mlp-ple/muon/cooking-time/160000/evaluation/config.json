{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/cooking-time",
            "train": {
                "size": 160000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 3,
                "d_block": 640,
                "dropout": 0.0
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 24,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00041605402791536366,
            "weight_decay": 1.315275739698746,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0001707011970037894
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 30
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
