{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/cooking-time",
            "train": {
                "size": 5120000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 960,
                "dropout": 0.46275601703642744
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 12,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 4.512795217089932e-05,
            "weight_decay": 0.006203870428050683,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00012588725455585394
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 93
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
