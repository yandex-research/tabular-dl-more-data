{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/cooking-time",
            "train": {
                "size": 640000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 400,
                "dropout": 0.07322344065621544
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 28,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.000347021615776151,
            "weight_decay": 0.7192361122609405,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0001556650028293143
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 32
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
