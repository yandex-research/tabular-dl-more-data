{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/istella",
            "train": {
                "size": 5120000,
                "sampling": "random"
            },
            "val_key": "core",
            "test_key": "core",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 976,
                "dropout": 0.4476860462746404
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00020043430935680603,
            "weight_decay": 0.06369196163980546,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.003422410164642845
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 118
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
