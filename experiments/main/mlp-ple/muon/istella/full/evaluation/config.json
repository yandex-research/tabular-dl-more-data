{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/istella",
            "train": {
                "size": "full",
                "sampling": "random"
            },
            "val_key": "core",
            "test_key": "core",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 960,
                "dropout": 0.45880565550323443
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 24,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00010213782698443745,
            "weight_decay": 0.03395373160142557,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0028265531868153174
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 115
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
