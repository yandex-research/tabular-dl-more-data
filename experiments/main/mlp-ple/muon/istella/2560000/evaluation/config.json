{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/istella",
            "train": {
                "size": 2560000,
                "sampling": "random"
            },
            "val_key": "core",
            "test_key": "core",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 4,
                "d_block": 816,
                "dropout": 0.47365004028573837
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 28,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00022142131396905512,
            "weight_decay": 0.07812042189088945,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00017437318884222307
            }
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 110
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
