{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/delivery-eta",
            "train": {
                "size": 640000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 656,
                "dropout": 0.3701791338001171
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 32,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00013790110069218886,
            "weight_decay": 1.1422050702726492,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00015869001345982282
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 108
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
