{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/delivery-eta",
            "train": {
                "size": 20000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
