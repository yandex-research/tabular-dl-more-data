{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/delivery-eta",
            "train": {
                "size": 1280000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 4,
                "d_block": 768,
                "dropout": 0.0
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 24,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0005273543423801077,
            "weight_decay": 0.3272211879970269,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00727154825620845
            }
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 46
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
