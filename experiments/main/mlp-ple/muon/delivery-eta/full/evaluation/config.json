{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/delivery-eta",
            "train": {
                "size": "full",
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 800,
                "dropout": 0.3590255292103508
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.00026084454414326396,
            "weight_decay": 0.3816803415691576,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0006306022010253978
            }
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 115
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
