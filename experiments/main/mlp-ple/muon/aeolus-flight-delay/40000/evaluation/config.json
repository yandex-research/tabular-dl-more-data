{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/aeolus-flight-delay",
            "train": {
                "size": 40000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 4,
                "d_block": 160,
                "dropout": 0.0
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 32,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0003563005996813495,
            "weight_decay": 0.7817720415022518,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.028360651371101955
            }
        },
        "batch_size": 512,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 58
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
