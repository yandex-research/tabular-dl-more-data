{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/aeolus-flight-delay",
            "train": {
                "size": 160000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 928,
                "dropout": 0.40238480778658675
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 24,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 5.7813901262556824e-05,
            "weight_decay": 1.3287372250635303,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.007061943881787653
            }
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 78
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
