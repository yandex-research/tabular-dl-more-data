{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/istella",
            "train": {
                "size": 1280000,
                "sampling": "random"
            },
            "val_key": "core",
            "test_key": "core",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 6,
                "d_block": 592,
                "dropout": 0.465528827805795
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 28,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 0.00016165682014986316,
            "weight_decay": 1.4241142880759303
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 54
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
