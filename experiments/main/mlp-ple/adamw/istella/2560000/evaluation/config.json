{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/istella",
            "train": {
                "size": 2560000,
                "sampling": "random"
            },
            "val_key": "core",
            "test_key": "core",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 5,
                "d_block": 512,
                "dropout": 0.4430993174760179
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 0.00013359959985649537,
            "weight_decay": 0.44401817230820195
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 110
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
