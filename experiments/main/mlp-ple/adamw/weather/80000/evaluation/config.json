{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/weather",
            "train": {
                "size": 80000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 864,
                "dropout": 0.22487558823505563
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 24,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 4.596212430486451e-05,
            "weight_decay": 0.34557312707925625
        },
        "batch_size": 512,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 64
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
