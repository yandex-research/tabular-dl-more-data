{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/cooking-time",
            "train": {
                "size": 2560000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 624,
                "dropout": 0.4691658873422882
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 20,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 5.039621721223536e-05,
            "weight_decay": 0.1663164638188118
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 34
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
