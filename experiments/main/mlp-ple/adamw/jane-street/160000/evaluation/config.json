{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/jane-street",
            "train": {
                "size": 160000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 4,
                "d_block": 336,
                "dropout": 0.37883544319821133
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 24,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 0.0007265796260504116,
            "weight_decay": 0.10989682404230501
        },
        "batch_size": 1024,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 39
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
