{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/delivery-eta",
            "train": {
                "size": 2560000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 832,
                "dropout": 0.46612889901135457
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 32,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 0.00032946421229197064,
            "weight_decay": 0.6618860730400798
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 103
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
