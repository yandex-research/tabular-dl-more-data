{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/bank-fraud-datafusion",
            "train": {
                "size": 1280000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 4,
                "d_block": 560,
                "dropout": 0.2925132029284871
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 12,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 3.835317169025432e-05,
            "weight_decay": 0.05994819753361776
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 11
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
