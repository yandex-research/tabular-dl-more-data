{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/bank-fraud-datafusion",
            "train": {
                "size": 80000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 912,
                "dropout": 0.0
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 16,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 0.0009258261775776135,
            "weight_decay": 0.014426263917790933
        },
        "batch_size": 512,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 11
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
