{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/maps-routing",
            "train": {
                "size": 10000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 1,
                "d_block": 96,
                "dropout": 0.0
            },
            "num_embeddings": {
                "type": "PiecewiseLinearEmbeddings",
                "d_embedding": 8,
                "activation": false,
                "version": "B"
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 3.279663303607571e-05,
            "weight_decay": 0.10104943509847002
        },
        "batch_size": 256,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "model_num_embeddings_bins": {
            "n_bins": 83
        }
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
