{
    "seed": 0,
    "objective": {
        "function": "project.tabm_.main",
        "output_keys": [
            "metrics",
            "val",
            "score"
        ]
    },
    "space": {
        "seed": 0,
        "data": {
            "dataset_dir": "data/jane-street",
            "train": {
                "size": 20000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": [
                    "_tune_",
                    "int",
                    1,
                    5
                ],
                "d_block": [
                    "_tune_",
                    "int",
                    64,
                    1024,
                    16
                ],
                "dropout": [
                    "_tune_",
                    "?uniform",
                    0.0,
                    0.0,
                    0.5
                ],
                "arch_type": "tabm",
                "k": 16
            },
            "type": "tabm"
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": [
                "_tune_",
                "loguniform",
                0.0001,
                0.005
            ],
            "weight_decay": [
                "_tune_",
                "loguniform",
                0.001,
                1.0
            ],
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": [
                    "_tune_",
                    "loguniform",
                    0.001,
                    0.1
                ]
            }
        },
        "batch_size": 256,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "share_training_batches": false,
        "compile": true
    },
    "sampler": {
        "type": "TPESampler",
        "n_startup_trials": 20
    },
    "n_trials": 100,
    "n_workers": 2
}
