{
    "function": "project.tabm_.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/aeolus-flight-delay",
            "train": {
                "size": 10000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 5,
                "d_block": 416,
                "dropout": 0.401407122974367,
                "arch_type": "tabm",
                "k": 16
            },
            "type": "tabm"
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0006707118758317239,
            "weight_decay": 0.9381805309146877,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.006489826936730322
            }
        },
        "batch_size": 256,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16",
        "share_training_batches": false,
        "compile": true
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
