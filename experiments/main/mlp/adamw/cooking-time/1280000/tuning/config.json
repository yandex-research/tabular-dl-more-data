{
    "seed": 0,
    "objective": {
        "function": "project.mlp.main",
        "output_keys": [
            "metrics",
            "val",
            "score"
        ]
    },
    "space": {
        "seed": 0,
        "data": {
            "dataset_dir": "data/cooking-time",
            "train": {
                "size": 1280000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": [
                    "_tune_",
                    "int",
                    1,
                    6
                ],
                "d_block": [
                    "_tune_",
                    "int",
                    64,
                    1024,
                    16
                ],
                "dropout": [
                    "_tune_",
                    "?uniform",
                    0.0,
                    0.0,
                    0.5
                ]
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": [
                "_tune_",
                "loguniform",
                3e-05,
                0.001
            ],
            "weight_decay": [
                "_tune_",
                "loguniform",
                0.005,
                5.0
            ]
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16"
    },
    "sampler": {
        "type": "TPESampler"
    },
    "n_trials": 100,
    "n_workers": 2
}
