{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/aeolus-flight-delay",
            "train": {
                "size": 40000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 6,
                "d_block": 880,
                "dropout": 0.0
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 0.00011749606655849163,
            "weight_decay": 0.005096233540172003
        },
        "batch_size": 512,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16"
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
