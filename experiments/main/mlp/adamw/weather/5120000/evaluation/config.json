{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/weather",
            "train": {
                "size": 5120000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 3,
                "d_block": 864,
                "dropout": 0.30722169198063726
            }
        },
        "optimizer": {
            "type": "torch.optim.AdamW",
            "lr": 0.0003682264223792352,
            "weight_decay": 0.14362019058813472
        },
        "batch_size": 4096,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16"
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
