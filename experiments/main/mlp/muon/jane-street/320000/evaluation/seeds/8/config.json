{
    "seed": 8,
    "data": {
        "dataset_dir": "data/jane-street",
        "train": {
            "size": 320000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 6,
            "d_block": 608,
            "dropout": 0.18620253253785501
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00012185481196543658,
        "weight_decay": 0.07339082265102828,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.014920141192992786
        }
    },
    "batch_size": 1024,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
