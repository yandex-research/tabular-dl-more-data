{
    "seed": 1,
    "data": {
        "dataset_dir": "data/aeolus-flight-delay",
        "train": {
            "size": 320000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 1,
            "d_block": 864,
            "dropout": 0.27535144184357396
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00015577507305551496,
        "weight_decay": 0.8009611725149358,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.001877930582289482
        }
    },
    "batch_size": 1024,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
