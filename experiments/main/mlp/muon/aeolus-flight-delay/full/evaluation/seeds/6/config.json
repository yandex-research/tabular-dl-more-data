{
    "seed": 6,
    "data": {
        "dataset_dir": "data/aeolus-flight-delay",
        "train": {
            "size": "full",
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 5,
            "d_block": 384,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 6.081601400829551e-05,
        "weight_decay": 0.5248857484888132,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00035214194199682775
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
