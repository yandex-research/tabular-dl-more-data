{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/aeolus-flight-delay",
            "train": {
                "size": 1280000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 832,
                "dropout": 0.0
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0005267207106512794,
            "weight_decay": 0.9194263911465649,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.001092395590365066
            }
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16"
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
}
