{
    "seed": 8,
    "data": {
        "dataset_dir": "data/delivery-eta",
        "train": {
            "size": 1280000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 5,
            "d_block": 448,
            "dropout": 0.0
        }
    },
    "optimizer": {
