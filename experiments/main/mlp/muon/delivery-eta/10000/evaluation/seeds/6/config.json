{
    "seed": 6,
    "data": {
        "dataset_dir": "data/delivery-eta",
        "train": {
            "size": 10000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 4,
            "d_block": 880,
            "dropout": 0.452954862509104
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 8.166721849552596e-05,
        "weight_decay": 0.9649498292585468,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00015727990321436015
        }
    },
    "batch_size": 256,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
