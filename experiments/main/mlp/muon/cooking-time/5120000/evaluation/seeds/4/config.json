{
    "seed": 4,
    "data": {
        "dataset_dir": "data/cooking-time",
        "train": {
            "size": 5120000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 1008,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00010458007506486805,
        "weight_decay": 0.5073087159638937,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00024645499403526085
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
