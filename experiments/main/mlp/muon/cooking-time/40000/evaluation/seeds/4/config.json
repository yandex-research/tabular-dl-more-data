{
    "seed": 4,
    "data": {
        "dataset_dir": "data/cooking-time",
        "train": {
            "size": 40000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 1,
            "d_block": 688,
            "dropout": 0.2601139013710113
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00022546107799713885,
        "weight_decay": 2.8090743772417244,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0001087355482966326
        }
    },
    "batch_size": 512,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
