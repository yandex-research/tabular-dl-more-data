{
    "seed": 2,
    "data": {
        "dataset_dir": "data/maps-routing",
        "train": {
            "size": 80000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 4,
            "d_block": 480,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 3.813134578639929e-05,
        "weight_decay": 1.19530614582706,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00018099956724435153
        }
    },
    "batch_size": 512,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
