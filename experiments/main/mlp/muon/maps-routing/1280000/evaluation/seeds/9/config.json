{
    "seed": 9,
    "data": {
        "dataset_dir": "data/maps-routing",
        "train": {
            "size": 1280000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 2,
            "d_block": 688,
            "dropout": 0.0
        }
