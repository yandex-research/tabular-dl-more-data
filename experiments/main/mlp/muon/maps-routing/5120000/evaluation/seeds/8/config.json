{
    "seed": 8,
    "data": {
        "dataset_dir": "data/maps-routing",
        "train": {
            "size": 5120000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 992,
            "dropout": 0.29754527166724976
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0008849581148797311,
        "weight_decay": 0.28580196388593565,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00019207246613914099
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
