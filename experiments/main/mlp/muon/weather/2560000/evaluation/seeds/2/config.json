{
    "seed": 2,
    "data": {
        "dataset_dir": "data/weather",
        "train": {
            "size": 2560000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 816,
            "dropout": 0.11272604988540053
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0002348737942016271,
        "weight_decay": 0.3298302277626571,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0002636264393304097
        }
    },
    "batch_size": 2048,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
