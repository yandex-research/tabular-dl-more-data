{
    "seed": 9,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 160000,
            "sampling": "random"
        },
        "val_key": "core",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 6,
            "d_block": 464,
            "dropout": 0.3690110041344714
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0008895937925683164,
        "weight_decay": 0.009717137242099397,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0002702569775078683
        }
    },
    "batch_size": 1024,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
