{
    "seed": 1,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 20000,
            "sampling": "random"
        },
        "val_key": "core",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 6,
            "d_block": 592,
            "dropout": 0.41218437583738265
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0006136528951353552,
        "weight_decay": 0.009888847326289594,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00011553135436919611
        }
    },
    "batch_size": 256,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
