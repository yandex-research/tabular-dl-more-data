{
    "seed": 6,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 1280000,
            "sampling": "random"
        },
        "val_key": "core",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 544,
            "dropout": 0.45846746566329816
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0009591077654187896,
        "weight_decay": 0.0566735916762888,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0009036752634032913
        }
    },
    "batch_size": 2048,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
