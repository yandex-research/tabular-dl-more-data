{
    "seed": 4,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 2560000,
            "sampling": "random"
        },
        "val_key": "core",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 6,
            "d_block": 832,
            "dropout": 0.40562214589965134
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 7.803046284234725e-05,
        "weight_decay": 0.041554200396301776,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.000130655206653777
        }
    },
    "batch_size": 2048,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
