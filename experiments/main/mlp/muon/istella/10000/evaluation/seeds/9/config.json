{
    "seed": 9,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 10000,
            "sampling": "random"
        },
        "val_key": "core",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 6,
            "d_block": 304,
            "dropout": 0.45943776126717445
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 9.080674448092951e-05,
        "weight_decay": 0.03563447248717651,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0030043330901246145
        }
    },
    "batch_size": 256,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
