{
    "seed": 7,
    "data": {
        "dataset_dir": "data/bank-fraud-datafusion",
        "train": {
            "size": "full",
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 5,
            "d_block": 512,
            "dropout": 0.13606958791708373
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 3.306279429020164e-05,
        "weight_decay": 0.008021676226432429,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0007750495104519796
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
