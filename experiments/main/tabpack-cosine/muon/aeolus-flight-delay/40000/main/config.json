{
    "seed": 0,
    "data": {
        "dataset_dir": "data/aeolus-flight-delay",
        "train": {
            "size": 40000,
            "sampling": "random"
        },
        "val_key": "time",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "n_models": 64,
    "model": {
        "activation": "ReLU",
        "d_block": 384,
        "num_embeddings": {
            "type": "CosineEmbeddingsPack"
        }
    },
    "optimizer": {
        "type": "MuonAdamWPack",
        "shared_step": true
    },
    "batch_size": 512,
    "n_epochs": -1,
    "patience": 16,
    "online_ensembles": {
        "greedy": {
            "type": "greedy",
            "update_type": "latest",
            "include_current_ensemble_in_pool": true,
            "patience": 32,
            "options": {
                "max_ensemble_size": 32
            }
        }
    },
    "sampler": {
        "type": "RandomSampler",
        "space": {
            "model": {
                "n_blocks": [
                    "_tune_",
                    "int",
                    1,
                    3
                ],
                "dropout": [
                    "_tune_",
                    "?uniform",
                    0.0,
                    0.0,
                    0.5
                ],
                "num_embeddings": {
                    "d_embedding": [
                        "_tune_",
                        "int",
                        8,
                        32,
                        4
                    ],
                    "init_scale": [
                        "_tune_",
                        "loguniform",
                        0.01,
                        10.0
                    ]
                }
            },
            "optimizer": {
                "lr": [
                    "_tune_",
                    "loguniform",
                    0.0001,
                    0.005
                ],
                "weight_decay": [
                    "_tune_",
                    "loguniform",
                    0.001,
                    1.0
                ],
                "muon_lr": [
                    "_tune_",
                    "loguniform",
                    0.001,
                    0.1
                ]
            }
        }
    },
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16",
    "save_final_predictions": false,
    "save_all_predictions": false,
    "track_online_ensemble_history": true,
    "track_experiments": true
}
