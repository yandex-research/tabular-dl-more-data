{
    "seed": 0,
    "objective": {
        "function": "project.xgboost_.main",
        "output_keys": [
            "metrics",
            "val",
            "score"
        ]
    },
    "space": {
        "seed": 0,
        "data": {
            "dataset_dir": "data/maps-routing",
            "train": {
                "size": 1280000,
                "sampling": "random"
            },
            "val_key": "time",
            "test_key": "time"
        },
        "model": {
            "booster": "gbtree",
            "n_estimators": 10000,
            "early_stopping_rounds": 300,
            "n_jobs": 8,
            "tree_method": "hist",
            "device": "cuda",
            "use_label_encoder": false,
            "max_depth": [
                "_tune_",
                "int",
                3,
                10
            ],
            "min_child_weight": [
                "_tune_",
                "loguniform",
                0.0001,
                100.0
            ],
            "subsample": [
                "_tune_",
                "uniform",
                0.5,
                1.0
            ],
            "colsample_bytree": [
                "_tune_",
                "uniform",
                0.5,
                1.0
            ],
            "learning_rate": [
                "_tune_",
                "loguniform",
                0.001,
                1.0
            ],
            "gamma": [
                "_tune_",
                "?loguniform",
                0,
                0.001,
                100.0
            ],
            "alpha": [
                "_tune_",
                "?loguniform",
                0.0,
                0.0001,
                5.0
            ],
            "lambda": [
                "_tune_",
                "?loguniform",
                0.0,
                0.0001,
                5.0
            ],
            "grow_policy": [
                "_tune_",
                "categorical",
                [
                    "depthwise",
                    "lossguide"
                ]
            ]
        },
        "fit": {
            "verbose": true
        }
    },
    "sampler": {
        "type": "TPESampler"
    },
    "n_trials": 100,
    "n_workers": 2
}
