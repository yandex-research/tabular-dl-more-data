{
    "seed": 3,
    "data": {
        "dataset_dir": "data/bank-fraud-datafusion",
        "train": {
            "size": 640000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 1,
            "d_block": 432,
            "dropout": 0.49012414549131905
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 9.107655833760886e-05,
        "weight_decay": 0.007605953215426342,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.002522065998351862
        }
    },
    "batch_size": 1024,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
