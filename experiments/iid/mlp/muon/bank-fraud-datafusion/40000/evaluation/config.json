{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/bank-fraud-datafusion",
            "train": {
                "size": 40000,
                "sampling": "random"
            },
            "val_key": "iid",
            "test_key": "time",
            "num_transform": "noisy-quantile"
        },
        "model": {
            "backbone": {
                "n_blocks": 3,
                "d_block": 144,
                "dropout": 0.09234815025491411
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0009125696422915352,
            "weight_decay": 0.6400653059773119,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.00012801889310817856
            }
        },
        "batch_size": 512,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16"
