{
    "seed": 5,
    "data": {
        "dataset_dir": "data/delivery-eta",
        "train": {
            "size": 80000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 4,
            "d_block": 896,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
