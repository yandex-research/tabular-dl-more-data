{
    "seed": 2,
    "data": {
        "dataset_dir": "data/delivery-eta",
        "train": {
            "size": 20000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 2,
            "d_block": 992,
            "dropout": 0.23099357175446034
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 3.80172578810464e-05,
        "weight_decay": 1.9674667981515515,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0002623857294714889
        }
    },
    "batch_size": 256,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
