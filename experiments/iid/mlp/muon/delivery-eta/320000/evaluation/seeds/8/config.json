{
    "seed": 8,
    "data": {
        "dataset_dir": "data/delivery-eta",
        "train": {
            "size": 320000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 4,
            "d_block": 896,
            "dropout": 0.07470069660538298
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0003092204412428281,
        "weight_decay": 0.8967872710815337,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00016049787575105694
        }
    },
    "batch_size": 1024,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
