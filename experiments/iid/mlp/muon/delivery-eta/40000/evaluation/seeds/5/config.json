{
    "seed": 5,
    "data": {
        "dataset_dir": "data/delivery-eta",
        "train": {
            "size": 40000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 2,
            "d_block": 432,
            "dropout": 0.18126376190926186
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
