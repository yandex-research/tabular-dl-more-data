{
    "seed": 4,
    "data": {
        "dataset_dir": "data/delivery-eta",
        "train": {
            "size": 640000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 960,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 3.203093056653176e-05,
        "weight_decay": 0.7917517143228417,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0009036291835756903
        }
    },
    "batch_size": 1024,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
