{
    "seed": 1,
    "data": {
        "dataset_dir": "data/maps-routing",
        "train": {
            "size": 2560000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 2,
            "d_block": 928,
            "dropout": 0.14993389998075915
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00010240344564989611,
        "weight_decay": 0.3285353184098574,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00011010165756087586
        }
    },
    "batch_size": 2048,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
