{
    "seed": 9,
    "data": {
        "dataset_dir": "data/maps-routing",
        "train": {
            "size": 40000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 5,
            "d_block": 976,
            "dropout": 0.0
        }
    },
    "optimizer": {
