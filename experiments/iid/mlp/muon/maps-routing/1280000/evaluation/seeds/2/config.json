{
    "seed": 2,
    "data": {
        "dataset_dir": "data/maps-routing",
        "train": {
            "size": 1280000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 832,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 5.243548491270662e-05,
        "weight_decay": 1.0918401191114686,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.000165957650144972
        }
    },
    "batch_size": 2048,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
