{
    "seed": 4,
    "data": {
        "dataset_dir": "data/maps-routing",
        "train": {
            "size": 5120000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 2,
            "d_block": 928,
            "dropout": 0.07980844029418097
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 3.129335763092559e-05,
        "weight_decay": 0.215141636382004,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0005706766849288068
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
