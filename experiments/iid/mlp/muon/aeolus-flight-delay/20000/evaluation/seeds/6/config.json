{
    "seed": 6,
    "data": {
        "dataset_dir": "data/aeolus-flight-delay",
        "train": {
            "size": 20000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 1,
            "d_block": 368,
            "dropout": 0.3088079818851278
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0002809784558028651,
        "weight_decay": 1.6592989305057402,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0010013773523468536
        }
    },
    "batch_size": 256,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
