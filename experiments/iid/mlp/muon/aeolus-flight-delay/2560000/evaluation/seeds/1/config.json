{
    "seed": 1,
    "data": {
        "dataset_dir": "data/aeolus-flight-delay",
        "train": {
            "size": 2560000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 4,
            "d_block": 464,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00047884250424672916,
        "weight_decay": 0.40756254673685893,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0014678469457414774
        }
    },
    "batch_size": 2048,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
