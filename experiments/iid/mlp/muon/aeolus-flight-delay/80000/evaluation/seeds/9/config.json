{
    "seed": 9,
    "data": {
        "dataset_dir": "data/aeolus-flight-delay",
        "train": {
            "size": 80000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 2,
            "d_block": 320,
            "dropout": 0.08573599820585141
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00039171123415620397,
        "weight_decay": 1.006829433491269,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0007987629358692728
        }
    },
    "batch_size": 512,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
