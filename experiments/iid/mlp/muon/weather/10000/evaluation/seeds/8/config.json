{
    "seed": 8,
    "data": {
        "dataset_dir": "data/weather",
        "train": {
            "size": 10000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 5,
            "d_block": 832,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0002182100123765298,
        "weight_decay": 1.1228755152339545,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0023249956336787382
        }
    },
    "batch_size": 256,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
