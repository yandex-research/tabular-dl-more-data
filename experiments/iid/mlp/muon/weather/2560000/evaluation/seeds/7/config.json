{
    "seed": 7,
    "data": {
        "dataset_dir": "data/weather",
        "train": {
            "size": 2560000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 6,
            "d_block": 976,
            "dropout": 0.05270711812775033
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0007596808722205591,
        "weight_decay": 0.031938992780733616,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0007598170607011502
        }
    },
    "batch_size": 2048,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
