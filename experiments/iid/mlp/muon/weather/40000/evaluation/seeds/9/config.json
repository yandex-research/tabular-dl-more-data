{
    "seed": 9,
    "data": {
        "dataset_dir": "data/weather",
        "train": {
            "size": 40000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 4,
            "d_block": 576,
            "dropout": 0.0
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 4.141295398145108e-05,
        "weight_decay": 1.234042755508273,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.00044803622376182864
        }
    },
    "batch_size": 512,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
