{
    "seed": 6,
    "data": {
        "dataset_dir": "data/cooking-time",
        "train": {
            "size": 5120000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 5,
            "d_block": 1024,
            "dropout": 0.1398940793786796
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.00015275199434817258,
        "weight_decay": 0.10439316501899426,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0005954173511706343
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
