{
    "function": "project.mlp.main",
    "base_config": {
        "data": {
            "dataset_dir": "data/cooking-time",
            "train": {
                "size": 2560000,
                "sampling": "random"
            },
            "val_key": "iid",
            "test_key": "time"
        },
        "model": {
            "backbone": {
                "n_blocks": 2,
                "d_block": 864,
                "dropout": 0.08551485565772335
            }
        },
        "optimizer": {
            "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
            "lr": 0.0005133561838145253,
            "weight_decay": 0.19625285717813457,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-08,
            "muon": {
                "lr": 0.0008096088834901164
            }
        },
        "batch_size": 2048,
        "patience": 16,
        "gradient_clipping_norm": 1.0,
        "amp_dtype": "bfloat16",
        "num_dtype": "bfloat16"
    },
    "n_seeds": 10,
    "save_experiments": true,
    "n_workers": 2
