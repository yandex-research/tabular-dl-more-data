{
    "seed": 3,
    "data": {
        "dataset_dir": "data/cooking-time",
        "train": {
            "size": "full",
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time"
    },
    "model": {
        "backbone": {
            "n_blocks": 6,
            "d_block": 976,
            "dropout": 0.07481657655823297
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 3.8104842481151824e-05,
        "weight_decay": 0.039744746512604366,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.000760329581858212
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
