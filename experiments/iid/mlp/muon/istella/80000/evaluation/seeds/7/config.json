{
    "seed": 7,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 80000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 832,
            "dropout": 0.07664860325538744
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 3.8233009306435517e-05,
        "weight_decay": 0.37579278546127,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0001969363008937718
        }
    },
    "batch_size": 512,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
