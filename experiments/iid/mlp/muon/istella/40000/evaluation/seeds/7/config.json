{
    "seed": 7,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 40000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 3,
            "d_block": 272,
            "dropout": 0.1317878521810902
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 8.667379765990448e-05,
        "weight_decay": 0.2958310009711224,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0006363462160510795
        }
    },
    "batch_size": 512,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
