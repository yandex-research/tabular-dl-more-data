{
    "seed": 1,
    "data": {
        "dataset_dir": "data/istella",
        "train": {
            "size": 10000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "core",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 2,
            "d_block": 592,
            "dropout": 0.36519360513325316
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0009360608842108855,
        "weight_decay": 0.15355240711920384,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0021263187822680133
        }
    },
    "batch_size": 256,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
