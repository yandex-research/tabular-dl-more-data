{
    "seed": 9,
    "data": {
        "dataset_dir": "data/jane-street",
        "train": {
            "size": 5120000,
            "sampling": "random"
        },
        "val_key": "iid",
        "test_key": "time",
        "num_transform": "noisy-quantile"
    },
    "model": {
        "backbone": {
            "n_blocks": 4,
            "d_block": 912,
            "dropout": 0.04633130628294632
        }
    },
    "optimizer": {
        "type": "vendor.muon.SingleDeviceMuonWithAuxAdam",
        "lr": 0.0003108765774681497,
        "weight_decay": 0.0641046423850158,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08,
        "muon": {
            "lr": 0.0008268709871723246
        }
    },
    "batch_size": 4096,
    "patience": 16,
    "gradient_clipping_norm": 1.0,
    "amp_dtype": "bfloat16",
    "num_dtype": "bfloat16"
}
